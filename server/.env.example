# MongoDB — local install, Docker, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/researchmesh

# Change this to a long random string before deploying anywhere
JWT_SECRET=change-me-to-a-long-random-string

# Access code required to create an admin account from the sign-up page.
# If left empty, the server generates a one-time code at startup and prints it in the console.
ADMIN_SIGNUP_CODE=

PORT=4000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Set to true to include the list of MongoDB operations in each response's extensions (debugging N+1)
LOG_QUERIES=false
