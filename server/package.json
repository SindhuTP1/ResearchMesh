{
  "name": "researchmesh-server",
  "version": "1.0.0",
  "description": "ResearchMesh GraphQL API — Express + Apollo Server + MongoDB",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "dev:memory": "node src/dev-memory.js",
    "seed:sample": "node src/seed/seed.js",
    "reset:people": "node src/seed/resetPeople.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^11.0.9",
    "@graphql-tools/utils": "^13.2.2",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "researchmesh": "file:..",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.0"
  }
