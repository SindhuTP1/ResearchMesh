# Leave unset in development — Vite proxies /graphql (HTTP + WebSocket) to http://localhost:4000.
# Set these only when the API is hosted on a different origin (e.g. after deploying).
# VITE_GRAPHQL_URL=https://api.example.com/graphql
# VITE_GRAPHQL_WS_URL=wss://api.example.com/graphql

# Video calls use WebRTC. The default STUN servers work on the same network and most home connections.
# Across strict NATs / campus firewalls you also need a TURN server, e.g.:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
